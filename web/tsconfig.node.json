{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  // The end-to-end tests run under Node rather than in a browser, and so does
  // everything that configures the build. Being listed here is also what lets the
  // type-aware linter see them at all.
  "include": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
